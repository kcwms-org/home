---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kevin Williams | Independent Software Developer">
  <section style="padding: 1.5rem 0;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Building Robust Software & AI Systems</h1>
    <p style="font-size: 1.25rem; color: #555; margin-bottom: 2rem;">
      Hi, I'm an independent software developer specializing in full-stack architecture, high-performance web applications, and practical AI integrations.
    </p>
    <div style="display: flex; gap: 1rem;">
      <a href="/cv" style="background: #0066cc; color: white; padding: 0.75rem 1.5rem; border-radius: 4px; text-decoration: none; font-weight: 500;">View CV & Projects</a>
      <a href="/contact" style="border: 1px solid #0066cc; color: #0066cc; padding: 0.75rem 1.5rem; border-radius: 4px; text-decoration: none; font-weight: 500;">Get in Touch</a>
    </div>
  </section>
</BaseLayout>